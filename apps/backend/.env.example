# Local development: copy to .env in apps/backend
ENV=development
DATABASE_URL=sqlite+aiosqlite:///./schemesathi.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-in-production
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PUBLIC_SITE_URL=http://localhost:5173
ENABLE_STAFF_API=false

# Optional generated chatbot answers; local retrieval works without this.
GEMINI_API_KEY=
CHATBOT_MODEL=gemini-3.6-flash

# Bhashini pipeline credentials (backend only)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Email configuration options:
# 1. Brevo HTTPS API (Recommended for Render & Production):
EMAIL_PROVIDER=brevo
EMAIL_FROM_ADDRESS=your_email@gmail.com
EMAIL_FROM_NAME=SchemeSaathi
SUPPORT_EMAIL=your_email@gmail.com
BREVO_API_KEY=

# 2. Direct SMTP (Gmail with App Password - Local / Paid host):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password

# 3. Local Development / Mock (prints OTP directly to terminal logs):
# EMAIL_PROVIDER=mock

TRANSLATION_MODEL=gemini-3.5-flash-lite
