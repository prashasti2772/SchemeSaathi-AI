# Local development: copy to .env in apps/backend
ENV=development
DATABASE_URL=sqlite+aiosqlite:///./schemesathi.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-in-production
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PUBLIC_SITE_URL=http://localhost:5173
ENABLE_STAFF_API=false

# Optional generated chatbot answers; local retrieval works without this.
GEMINI_API_KEY=
CHATBOT_MODEL=gemini-3.6-flash

# Bhashini pipeline credentials (backend only)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Authentication and recovery operate over Brevo email OTP only.
# SMS providers such as Firebase or MSG91 are intentionally not used for this phase.
EMAIL_PROVIDER=brevo
EMAIL_FROM_ADDRESS=your_verified_sender@yourdomain.com
EMAIL_FROM_NAME=SchemeSaathi Support
SUPPORT_EMAIL=your_verified_sender@yourdomain.com
BREVO_API_KEY=

# Keep any provider-specific credentials in your local .env file, not in Git.
# The app uses Brevo's HTTPS SMTP-over-API endpoint and does not require SMTP
# or Resend configuration for the auth flow.

TRANSLATION_MODEL=gemini-3.5-flash-lite
