# Local development: copy to .env in apps/backend
ENV=development
DATABASE_URL=sqlite+aiosqlite:///./schemesathi.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-in-production
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PUBLIC_SITE_URL=http://localhost:5173
ENABLE_STAFF_API=false

# Optional generated chatbot answers; local retrieval works without this.
GEMINI_API_KEY=
CHATBOT_MODEL=gemini-3.6-flash

# Bhashini pipeline credentials (backend only)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Optional real outreach; disabled by default.
# IDs come from SMS > Templates (SMS Flow), not the separate OTP product.
SMS_LIVE_ENABLED=false
MSG91_AUTH_KEY=
# Website outreach Flow with the case-sensitive ##website## variable.
MSG91_TEMPLATE_ID=
# Replace this example with your provider-approved sender.
MSG91_SENDER_ID=SCHMAT

# Password recovery: send OTPs to the account's registered email.
# Gmail uses a Google app password (not your account password).
# Render Free blocks SMTP ports 25/465/587. For hosting, use EMAIL_PROVIDER=resend
# with an HTTPS API key and a verified sending domain; see docs/PASSWORD_RECOVERY.md.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
# Alternative: EMAIL_PROVIDER=resend, verified EMAIL_FROM_ADDRESS and:
RESEND_API_KEY=

# Separate SMS Flow for password recovery: ##otp## and a 5-minute expiry notice.
MSG91_OTP_TEMPLATE_ID=
